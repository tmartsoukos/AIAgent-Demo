# Μεταβλητές που διαβάζει το docker-compose.yml.
# Αντιγραφή σε .env και προσαρμογή ανά περιβάλλον:
#   cp .env.example .env
#
# Τοπικά μπορούν να μείνουν και τα δύο κενά — το compose πέφτει σε localhost.
# Στο EC2 βάλε την public IP του instance και στα δύο.

# Η διεύθυνση του backend όπως τη βλέπει ο BROWSER του χρήστη.
# Ενσωματώνεται στο frontend bundle κατά το build, οπότε κάθε αλλαγή απαιτεί
# rebuild: docker compose up -d --build
NEXT_PUBLIC_API_URL=http://localhost:8000

# Το origin απ' όπου σερβίρεται το frontend. Πρέπει να ταιριάζει ακριβώς
# (scheme + host + port), αλλιώς ο browser μπλοκάρει τις απαντήσεις.
# Πολλαπλές τιμές χωρίζονται με κόμμα.
CORS_ORIGINS=http://localhost:3000
