# Μεταβλητές που διαβάζει το docker-compose.yml.
# Αντιγραφή σε .env και προσαρμογή ανά περιβάλλον:
#   cp .env.example .env
#
# Τοπικά μπορούν να μείνουν όλα κενά — το compose πέφτει σε localhost/HTTP.

# Το domain που εξυπηρετεί το Caddy. Με τιμή, εκδίδεται αυτόματα
# πιστοποιητικό Let's Encrypt. Κενό ή απόν: σκέτο HTTP στο :80.
# Παράδειγμα: DOMAIN=themis-agent.duckdns.org
DOMAIN=

# Η διεύθυνση του backend όπως τη βλέπει ο BROWSER του χρήστη.
# Ενσωματώνεται στο frontend bundle κατά το build, οπότε κάθε αλλαγή απαιτεί
# rebuild: docker compose up -d --build
# Πίσω από το Caddy γίνεται same-origin: https://<domain>/api
NEXT_PUBLIC_API_URL=http://localhost:8000

# Το origin απ' όπου σερβίρεται το frontend. Πρέπει να ταιριάζει ακριβώς
# (scheme + host + port), αλλιώς ο browser μπλοκάρει τις απαντήσεις.
# Πίσω από το Caddy τα αιτήματα είναι same-origin και το CORS δεν ενεργοποιείται.
CORS_ORIGINS=http://localhost:3000
